@article{el-kader2026,
  title = {Write to Heal: The Impact of an Expressive Writing Intervention on Stress in First-Year Nursing Students},
  shorttitle = {Write to Heal},
  author = {{El-Kader}, Rabab Gad Abd and Aneesh, Ramya Shine and Ragab, Basma Maher and Sheryl, Tesa Ann and Ahmed, Taif Mutaz Ibrahim and Mohamed, Aziza Ibrahim and Alanazi, Mohamed and Elwasefy, Shereen Ahmed and Moreljwab, Mohammed Hassan and Fadul Mokhtar, Amani Mahmoud},
